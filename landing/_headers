# Cloudflare's equivalent of the "headers" block in vercel.json.
#
# Cloudflare does not read vercel.json. Moving the site without this file
# would drop every security header silently: the pages would look and behave
# exactly the same, and the protection would simply be gone.
#
# Keep this and vercel.json saying the same thing until the DNS is moved.
# After that, vercel.json can go.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: off
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests

# The typefaces are content-addressed by name and never change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Screenshots do change when the app does, so a week rather than a year.
/shots/*
  Cache-Control: public, max-age=604800
